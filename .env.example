# Эти значения выдаёт панель xray.watch в разделе «Агенты» → «Добавить агент».
# Обычно редактировать этот файл вручную не нужно: панель формирует готовую
# команду установки уже с XRAYWATCH_CONTROL_URL и XRAYWATCH_TRUST_KEY.
XRAYWATCH_CONTROL_URL=https://control.example.com
XRAYWATCH_TRUST_KEY=

# Необязательные настройки.
XRAYWATCH_LISTEN_PORT=18443
XRAYWATCH_VERSION=latest
XRAYWATCH_STATE_VOLUME=xraywatch-node-agent-state

